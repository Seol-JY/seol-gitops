{
  "uid": "hpa-autoscaling",
  "title": "HPA / 오토스케일링",
  "tags": [
    "hpa",
    "autoscaling"
  ],
  "timezone": "browser",
  "schemaVersion": 42,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "options": [],
        "refresh": 1,
        "regex": "",
        "hide": "",
        "includeAll": false
      },
      {
        "name": "namespace",
        "label": "네임스페이스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kube_horizontalpodautoscaler_status_current_replicas, namespace)",
        "query": {
          "query": "label_values(kube_horizontalpodautoscaler_status_current_replicas, namespace)",
          "refId": "Prometheus-namespace-Variable-Query"
        },
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "options": [],
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": ""
      },
      {
        "name": "hpa",
        "label": "HPA",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(kube_horizontalpodautoscaler_status_current_replicas{namespace=\"$namespace\"}, horizontalpodautoscaler)",
        "query": {
          "query": "label_values(kube_horizontalpodautoscaler_status_current_replicas{namespace=\"$namespace\"}, horizontalpodautoscaler)",
          "refId": "Prometheus-hpa-Variable-Query"
        },
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "options": [],
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "전체 준비된 파드",
      "description": "네임스페이스 전체 Ready 파드 수, 앱 + DB + 캐시",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "count(kube_pod_status_ready{namespace=\"$namespace\", condition=\"true\"} == 1)",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "type": "stat",
      "title": "앱 파드 (HPA 대상)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "kube_deployment_status_replicas_ready{namespace=\"$namespace\"} and on(namespace, deployment) label_replace(kube_horizontalpodautoscaler_info{namespace=\"$namespace\", horizontalpodautoscaler=\"$hpa\"}, \"deployment\", \"$1\", \"scaletargetref_name\", \"(.+)\")",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "orientation": "auto",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "description": "HPA 대상 Deployment 의 Ready 파드 수"
    },
    {
      "id": 2,
      "type": "stat",
      "title": "HPA 가 원한 수",
