      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "description": "Traefik 버킷이 0.1·0.3·1.2·5.0 초 4개뿐, 95ms 는 100ms 미만이라는 뜻일 뿐"
    },
